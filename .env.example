# Copy to .env and replace every value.

# Public URL of the engine. Must be https in production.
IAM_ISSUER=http://localhost:8080

# 32 random bytes, base64. Generate: openssl rand -base64 32
# Losing it makes stored signing keys and TOTP secrets unreadable.
IAM_MASTER_KEY=REPLACE_ME

# Instance admin API key (>= 32 chars), created on the very first start only.
# Deleting it later through the API is permanent.
# Generate: openssl rand -hex 32
IAM_BOOTSTRAP_ADMIN_KEY=REPLACE_ME

# Allows an http issuer. Never set in production.
IAM_DEV_MODE=true

# Serve Swagger UI at /docs. Keep off in production.
IAM_ENABLE_DOCS=true

# Passkeys: relying party ID (domain, default: issuer host) and login UI origins.
# Each origin's host must be the RP ID or a subdomain of it, and use https
# unless IAM_DEV_MODE=true; the engine refuses to start otherwise.
# IAM_WEBAUTHN_RP_ID=example.com
IAM_WEBAUTHN_ORIGINS=http://localhost:3000
# Count rate limits in Postgres so they hold across several engine instances.
IAM_SHARED_RATE_LIMITS=false

# Password-hashing capacity (optional; see docs/OPERATIONS.md "Capacity and
# overload"). Each argon2id hash holds ~64 MiB while running.
# Concurrent hash slots. 0 auto-sizes from GOMAXPROCS (cgroup-CPU-aware), min 2.
# IAM_HASH_SLOTS=0
# Make an insufficient-memory sizing check fatal at startup instead of a warning.
# IAM_STRICT_SIZING=false
# How long a request waits for a hash slot before it is shed as 503.
# IAM_HASH_WAIT_TIMEOUT=3s
# Password logins allowed per organization per minute (across its keys/IPs).
# IAM_ORG_LOGIN_LIMIT=1200
