# Production settings. Copy to .env.prod (gitignored) and replace every value.
# Better: keep these in your secrets manager and inject them at deploy time.

# Public hostname of the engine. DNS must point here; Caddy gets the certificate.
IAM_DOMAIN=auth.example.com

# 32 random bytes, base64:  openssl rand -base64 32
# Back it up: losing it makes signing keys and TOTP secrets unreadable.
IAM_MASTER_KEY=REPLACE_ME

# Database password:  openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_ME

# Passkeys are bound to your login UI's domain (or a parent domain) and origin.
IAM_WEBAUTHN_RP_ID=example.com
IAM_WEBAUTHN_ORIGINS=https://app.example.com

# Browser origins allowed to call the API directly (CORS). Leave unset when only
# your backend calls the engine. Exact origins only.
# IAM_CORS_ORIGINS=https://app.example.com

# During a master key rotation only: the old key, accepted for decryption.
# Remove it only after `iamd rotate-keys --check` succeeds (see docs/DEPLOYMENT.md).
# IAM_MASTER_KEY_PREVIOUS=

# Instance admin key, created on the first start only:  openssl rand -hex 32
# After creating your own admin keys through the API, you can remove this line.
IAM_BOOTSTRAP_ADMIN_KEY=REPLACE_ME
