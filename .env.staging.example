# WS9 staging settings. Copy to .env.staging (gitignored) and replace every
# value. These are STAGING-ONLY and disposable: generate fresh keys here, never
# reuse any production or developer value, and never commit the filled file.
# Better still: inject them from the host's secret store at `up` time instead of
# writing them to disk.

# Public hostname of the staging engine. DNS (or the provider hostname) must
# point here; Caddy obtains the TLS certificate for it automatically.
IAM_DOMAIN=iam.staging.example

# 32 random bytes, base64:  openssl rand -base64 32
# Staging-only. Losing it makes this stack's signing keys/TOTP unreadable, which
# is fine for a disposable stack — do NOT copy a production key here.
IAM_MASTER_KEY=REPLACE_ME

# Database password (staging-only):  openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_ME

# Instance admin key, created on first start only:  openssl rand -hex 32
# Rotate to a managed instance-admin key via the API after boot, then remove.
IAM_BOOTSTRAP_ADMIN_KEY=REPLACE_ME

# Passkeys bind to the login UI's domain/origin. For a staging round trip these
# are the staging host unless a separate staging login UI is used. Invalid
# values fail fast at boot.
IAM_WEBAUTHN_RP_ID=iam.staging.example
IAM_WEBAUTHN_ORIGINS=https://iam.staging.example

# --- HTTPS login-test harness (not read by compose) -------------------------
# Values the live federation harness uses when pointed at this staging stack.
# The engine builds its callback as {IAM_ISSUER}/idp/callback, so with dev mode
# off that callback is HTTPS. Register this exact callback as a redirect URI in
# the Google and Entra app registrations before the round trip.
#   STAGING_ISSUER=https://iam.staging.example
#   STAGING_CALLBACK=https://iam.staging.example/idp/callback
#   STAGING_RETURN_URL=https://iam.staging.example/sso-return
# Run the smoke/feature suites against staging with:
#   python scripts/smoke_test.py https://iam.staging.example
#   python scripts/features_test.py https://iam.staging.example
# (IAM_BOOTSTRAP_ADMIN_KEY must be exported for the admin-scoped calls.)
